// Sistema de Empréstimo de Equipamentos — Unoesc
// Schema conforme especificação em especificacoes/spec.md (seção 3. Modelagem de Dados)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // A URL é resolvida em prisma.config.ts (Prisma 7) a partir de DATABASE_URL
}

/// Estudantes e professores (importados inicialmente via planilha da coordenação).
///
/// Chamava-se `Usuario` até a Tarefa 10. O nome mudou porque o sistema passou a
/// ter **duas** espécies de gente dentro dele: quem retira equipamento e quem
/// administra o painel. Com `Administrador.usuario` sendo o login do secretário,
/// "usuário" ficou querendo dizer duas coisas — e a que aparece no tablet é uma
/// pessoa, não uma conta.
model Pessoa {
  /// Chave primária. String para preservar zeros à esquerda.
  matricula String @id
  /// Nome completo, em Title Case ("Ana Maria de Souza").
  ///
  /// A forma é garantida na escrita, não na leitura: tanto a importação de
  /// planilha quanto o seed passam o valor por `normalizarNome`
  /// ([sanitizacao.ts](../src/lib/sanitizacao.ts)) antes de gravar. Sem isso a
  /// mesma pessoa entrava três vezes com três grafias, e a busca do painel
  /// achava uma e perdia as outras.
  nome      String
  /// "Estudante" ou "Professor" (Tarefa 8.1).
  ///
  /// Eram "ALUNO" e "PROFESSOR" até a Tarefa 8.1, que mudou o termo e a caixa
  /// de uma vez: o vocabulário da instituição passou a ser "Estudante", e o
  /// valor é gravado **na forma exibida** porque a tarefa pede exatamente isso.
  /// A consequência boa é que a tela não tem mais um `de-para` de perfil.
  ///
  /// A planilha pode trazer qualquer variante ("aluno", "Alunos", "prof",
  /// "Docente"): quem converte é `normalizarPerfil`. O que **não** for uma das
  /// duas coisas reprova a linha na importação — perfil adivinhado errado muda
  /// quem pode retirar equipamento e não deixa rastro.
  perfil    String
  /// Cursos vinculados (ex: "Sistemas de Informação, Ciência da Computação").
  ///
  /// String única separada por ", ", **sempre na ordem hierárquica** de
  /// `CURSOS_OFICIAIS` (Sistemas de Informação, Ciência da Computação,
  /// Engenharia da Computação), com os cursos fora dessa lista no fim, em ordem
  /// alfabética. Siglas e variações ("SI", "ciencia da computacao") são
  /// convertidas na escrita por `normalizarCursos`.
  ///
  /// A ordem fixa é o que faz "EC, SI" e "SI, EC" gravarem a mesma string — sem
  /// ela, a busca do painel depende de como a coordenação digitou.
  cursos    String
  /// "ATIVO" ou "INATIVO" (Tarefa 8).
  ///
  /// É a aposentadoria do cadastro, pelo mesmo motivo que o `INATIVO` do
  /// `Equipamento`: pessoa não é apagada, porque `Emprestimo.pessoa_id` aponta
  /// para ela e um DELETE levaria junto o histórico — conferido, o banco recusa
  /// com P2003.
  ///
  /// `INATIVO` **bloqueia a retirada e permite a devolução**: quem saiu da
  /// faculdade costuma estar com um aparelho na mochila, e travar a devolução
  /// empurraria o equipamento para nunca voltar.
  status    String @default("ATIVO")
  /// O dia em que os rostos da avaliação foram mostrados a esta pessoa pela
  /// última vez, **truncado a 00:00 no fuso da máquina** (Tarefa 14). Nulo
  /// enquanto ela nunca foi perguntada.
  ///
  /// É a regra de frequência inteira: `confirmarRetirada` só mostra os rostos
  /// se este campo é nulo ou está a `INTERVALO_ENTRE_AVALIACOES_DIAS` ou mais
  /// — e grava o dia de hoje **quando os rostos aparecem**, não quando alguém
  /// responde. Sem isso, quem ignora a pesquisa é justamente quem a veria em
  /// toda retirada.
  ///
  /// Truncado ao dia porque é o mesmo grão de `Avaliacao.dia`: gravar o
  /// instante aqui recriaria, do lado da pessoa, o carimbo com segundos que a
  /// `Avaliacao` não tem de propósito.
  avaliacao_pedida_em DateTime?

  emprestimos Emprestimo[]
}

/// Uma linha por vez que os rostos da avaliação apareceram no fim de uma
/// retirada (Tarefa 14). `nota` nula = apareceram e a pessoa não respondeu —
/// é o que dá a taxa de resposta (respondidas ÷ pedidas), a métrica que
/// denuncia fadiga antes da reclamação.
///
/// **Não há matrícula, perfil nem hora aqui, de propósito.** Um carimbo com
/// segundos cruzaria trivialmente com `Emprestimo.data_retirada` e revelaria
/// quem deu a nota 1; o perfil identificaria o professor do dia. Com só o dia,
/// quem lê o banco sabe *quem foi perguntado naquele dia* (pelo
/// `Pessoa.avaliacao_pedida_em`) e *quais notas saíram naquele dia*, e não o
/// pareamento — exceto no dia em que uma pessoa só foi perguntada, que é a
/// limitação inerente de população pequena, e a wiki diz isso.
model Avaliacao {
  /// **Aleatório, e não autoincremento.** O id sequencial seria um carimbo de
  /// tempo disfarçado: a linha nasce na mesma transação do `Emprestimo`, então
  /// a ordem dos ids no dia D seria a ordem de `data_retirada` das pessoas
  /// perguntadas em D — três linhas, três pessoas, um `ORDER BY` de cada lado,
  /// e o pareamento sairia inteiro. Sem `@default`, o Prisma obriga quem cria a
  /// linha a fornecer o id, e o único caminho é `idAleatorio()` em
  /// [actions.ts](../src/app/actions.ts). Efeito colateral bem-vindo: chutar
  /// uma linha ainda não respondida passa de trivial a 1 em 2³¹.
  id   Int     @id
  /// 1 = Muito ruim, 2 = Ruim, 3 = Bom, 4 = Muito bom. Nula até o toque, e
  /// gravada uma vez só (`updateMany` filtrado por `nota: null`).
  nota Int?
  /// "AAAA-MM-DD" no fuso da máquina. Dia, não instante — ver o comentário do
  /// modelo.
  dia  String
}

/// Chave-valor para o que precisa mudar sem deploy (Tarefa 14). Hoje só uma
/// chave: `url_formulario_feedback`, a URL do formulário externo que o QR code
/// da tela de sucesso aponta. Mora no banco porque "anos sem atualização"
/// corta dos dois lados — se o link do formulário mudar, não pode exigir
/// deploy para acompanhar. Sem a linha, ou com valor vazio, o QR não aparece.
model Configuracao {
  chave String @id
  valor String
}

/// Contas de acesso ao Painel Administrativo (Tarefa 10).
///
/// Substituiu a senha mestre única do `.env`. O motivo é responsabilização: com
/// uma senha só, "quem deu baixa neste equipamento" não tinha resposta possível
/// — todo mundo era a mesma pessoa para o sistema.
///
/// **Não há tela de cadastro de administrador neste MVP**, por decisão da
/// Tarefa 10: as contas nascem pelo `prisma/seed.ts`. A consequência a conhecer
/// é que recuperar uma senha esquecida se faz apagando a linha no
/// `npm run db:studio` e rodando `npm run db:seed` de novo, que a recria com a
/// senha padrão.
model Administrador {
  id      Int    @id @default(autoincrement())
  /// Nome de quem opera — é o que aparece no painel ("Secretário", "Cidi").
  nome    String
  /// Login digitado na tela de login. Único: é a chave da busca.
  ///
  /// O seed grava em minúsculas, e a busca **ignora caixa e espaços em volta**
  /// — ver `procurarAdministrador` em
  /// [sessao-admin.ts](../src/lib/sessao-admin.ts). Não é precaução: o `=` do
  /// SQLite é sensível à caixa, e como a única forma de acrescentar uma conta
  /// neste MVP é digitando no `db:studio`, uma linha gravada como
  /// "Coordenacao" existia na tabela e não havia nada que se pudesse digitar
  /// na tela para entrar com ela. Medido antes de virar código.
  usuario String @unique
  /// **Hash bcrypt**, nunca a senha. Sessenta caracteres, prefixo `$2b$10$`.
  ///
  /// O hash também é a **chave que assina o cookie de sessão** — ver
  /// [sessao-admin.ts](../src/lib/sessao-admin.ts). Daí sai de graça que trocar
  /// a senha de alguém, ou apagar a conta, derruba a sessão daquela pessoa e só
  /// dela, sem nenhum segredo extra no `.env`.
  senha   String

  /// As mudanças de situação de equipamento que esta conta fez (Tarefa 17).
  /// A relação é opcional do outro lado, de propósito: apagar a conta para
  /// recuperar a senha não pode nem ser recusado nem levar o histórico junto.
  mudancas MudancaDeStatus[]
}

/// Categorias do inventário ("Notebook", "Tablet", "Extensão").
///
/// Virou tabela na Tarefa 6: enquanto era uma String no `Equipamento`, a grafia
/// era decidida no cadastro e cada variante ("notebook", "Notebook") abria uma
/// categoria nova no tablet. Com `nome` único, o banco é quem garante que só
/// existe uma.
model Categoria {
  id   Int    @id @default(autoincrement())
  /// Nome exibido no tablet e no painel. Único — inclusive é o que impede
  /// duas grafias da mesma coisa.
  nome String @unique

  equipamentos Equipamento[]
}

/// Inventário físico de equipamentos.
model Equipamento {
  /// Identificador único da etiqueta (ex: "NOTE-01", "EXT-05").
  id           String @id
  /// FK para Categoria.id. Obrigatória: equipamento sem categoria não aparece
  /// em lugar nenhum do tablet, que é organizado por categoria.
  categoria_id Int
  /// "DISPONIVEL", "EMPRESTADO", "MANUTENCAO" ou "INATIVO".
  ///
  /// `INATIVO` é a aposentadoria do item: ele sai de circulação para sempre sem
  /// sair do banco, porque apagá-lo levaria junto o histórico de empréstimos
  /// que aponta para ele.
  status       String @default("DISPONIVEL")

  /// `onDelete: Restrict` é o que faz a regra "só apaga categoria vazia" ser do
  /// banco, e não da tela: um DELETE com equipamento vinculado volta P2003.
  categoria   Categoria    @relation(fields: [categoria_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emprestimos Emprestimo[]
  /// O histórico de situação (Tarefa 17) — ver `MudancaDeStatus`.
  mudancas    MudancaDeStatus[]
}

/// Uma linha por mudança de situação feita **no painel** (Tarefa 17):
/// `DISPONIVEL` ↔ `MANUTENCAO` ↔ `INATIVO`, com quem fez e quando. É o que o
/// relatório Índice de Manutenção lê — antes dela, `Equipamento.status` guardava
/// só o estado atual, e "desde quando o NOTE-09 está em conserto" não tinha
/// resposta.
///
/// **`EMPRESTADO` não entra, de propósito.** Retirada e baixa já moram em
/// `Emprestimo`, com os seus três carimbos; gravar o mesmo evento aqui seria
/// dois donos para ele. Pelo mesmo motivo o seed e o `db:demo`, que escrevem
/// `Equipamento.status` direto, não passam por aqui — só a action
/// `alterarStatusEquipamento` grava, dentro da mesma transação que muda o
/// status, e só quando a mudança de fato aconteceu (o `updateMany` contou 1).
///
/// **Vazio antes da migration, sem linha de abertura.** Um aparelho que já
/// estava em manutenção no dia da instalação fica sem entrada: inventar uma com
/// o carimbo da migration seria dado inventado dentro de uma métrica. O
/// relatório mostra "desde —" para ele, e a saída dele não vira estadia.
model MudancaDeStatus {
  /// **Autoincremento de verdade**, ao contrário da `Avaliacao`: isto é log de
  /// auditoria, e a ordem de gravação é informação, não vazamento.
  id                 Int      @id @default(autoincrement())
  equip_id           String
  /// A situação lida **dentro da transação**, não a que a tela mostrava:
  /// `DISPONIVEL` e `INATIVO` aceitam duas origens cada, e o valor visto antes
  /// poderia ser o de outra aba.
  de                 String
  para               String
  em                 DateTime @default(now())
  /// Nulo quando a conta foi apagada — ver a relação abaixo.
  administrador_id   Int?
  /// **Retrato do nome na hora**, e não só a chave. A recuperação de senha
  /// documentada é apagar a conta e ressemear: com `Restrict` o banco recusaria
  /// assim que a conta tivesse histórico; com `Cascade` a senha esquecida
  /// apagaria o histórico; com `SetNull` sem o retrato, o "quem" viraria "—".
  /// Isto é semântica de auditoria — quem era, na hora —, e é por isso que um
  /// nome corrigido no seed **não** reescreve as linhas antigas.
  administrador_nome String

  /// `onUpdate: Cascade` pelo mesmo motivo de `Emprestimo`: corrigir uma
  /// etiqueta leva o histórico junto. `onDelete: Restrict` porque equipamento
  /// nunca é apagado, e o histórico é mais um motivo para não ser.
  equipamento   Equipamento    @relation(fields: [equip_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// `SetNull` provado em cópia do banco na Tarefa 17: apagar a conta deixa
  /// `administrador_id` nulo, o nome intacto e o `foreign_key_check` vazio.
  administrador Administrador? @relation(fields: [administrador_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// O relatório lê as linhas de um equipamento ordenadas por `em` para montar
  /// as estadias; é a consulta que este índice serve.
  @@index([equip_id, em])
}

/// Logs de movimentação — um registro isolado por item emprestado.
model Emprestimo {
  id             Int       @id @default(autoincrement())
  /// FK para Pessoa.matricula. Chamava-se `usuario_id` até a Tarefa 10.
  pessoa_id      String
  /// FK para Equipamento.id.
  equip_id       String
  /// Preenchido na criação: o aluno tocou "Confirmar" no tablet (Fluxo 1).
  data_retirada  DateTime  @default(now())
  /// **A declaração no tablet**: o aluno disse que devolveu e deixou o item na
  /// bancada (`ATIVO` -> `AGUARDANDO_BAIXA`, Fluxo 2). Não é a hora em que o
  /// equipamento voltou ao inventário — essa é a `data_baixa`.
  ///
  /// Nulo enquanto o empréstimo está `ATIVO`.
  data_devolucao DateTime?
  /// **A conferência física**: o secretário recolheu o item da bancada e
  /// confirmou o recebimento no painel (`AGUARDANDO_BAIXA` -> `CONCLUIDO`,
  /// Fluxo 3). Terceiro marcador temporal, criado na Tarefa 12.
  ///
  /// Existe para medir o gargalo operacional `data_baixa - data_devolucao`: o
  /// tempo em que o aparelho ficou na bancada, invisível para o tablet e para o
  /// inventário. Até a Tarefa 12 esse intervalo era incalculável, porque a
  /// baixa **sobrescrevia** a `data_devolucao` com o próprio instante — os dois
  /// eventos dividiam um campo só, e o mais recente apagava o outro.
  ///
  /// Nulo nos empréstimos concluídos **antes** da Tarefa 12, de propósito: a
  /// migration não copia a `data_devolucao` deles para cá. O valor seria o
  /// instante certo da baixa, mas o intervalo resultante seria zero — uma
  /// prateleira instantânea que ninguém mediu entrando na média como se tivesse
  /// sido. Nulo se exclui sozinho do cálculo.
  data_baixa     DateTime?
  /// "ATIVO" | "AGUARDANDO_BAIXA" | "CONCLUIDO".
  status         String    @default("ATIVO")

  /// `onUpdate: Cascade` é o que faz a correção de uma matrícula digitada
  /// errada não quebrar o histórico: a PK da `Pessoa` muda e todos os
  /// empréstimos dela vão junto, na mesma instrução.
  ///
  /// Está **explícito de propósito**, embora seja o padrão do Prisma para
  /// relação obrigatória — a migration inicial já tinha gravado
  /// `ON UPDATE CASCADE` no SQL sem ninguém pedir. Escrito aqui, é regra do
  /// projeto; implícito, era coincidência do gerador. O comportamento foi
  /// exercitado contra uma cópia do `dev.db` na Tarefa 8, junto com o
  /// `PRAGMA foreign_keys = 1` de que ele depende.
  ///
  /// `onDelete: Restrict` (também o padrão) é o que torna `INATIVO` a única
  /// saída para um cadastro que sai de circulação.
  pessoa      Pessoa      @relation(fields: [pessoa_id], references: [matricula], onDelete: Restrict, onUpdate: Cascade)
  equipamento Equipamento @relation(fields: [equip_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Todos os relatórios com período filtram por `data_retirada >= de AND
  /// data_retirada < fim` (Tarefa 16). O índice entrou de carona na migration
  /// da Tarefa 17, como a §0 da 16 prometeu — a 16 não teve migration.
  @@index([data_retirada])
}
