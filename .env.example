# Banco de dados SQLite (arquivo único, portátil).
# Caminho relativo à raiz do projeto — o arquivo fica em ./dev.db (CLI e app usam o mesmo)
DATABASE_URL="file:./dev.db"

# As contas do Painel Administrativo (/admin) ficam na tabela Administrador,
# com a senha em hash bcrypt. São criadas por `npm run db:seed` (Tarefa 10).
# Não há senha do painel em variável de ambiente.
