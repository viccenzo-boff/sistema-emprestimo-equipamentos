# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# permitir o template de variáveis de ambiente
!.env.example

# banco SQLite local (gerado por prisma migrate / seed)
*.db
*.db-journal
*.db-wal
*.db-shm

# planilha real da coordenação: contém dados pessoais, não versionar
/prisma/data/pessoas.csv
/prisma/data/usuarios.csv

# cache da ferramenta impeccable
.impeccable/

# log de observacoes de skill (meta-trabalho, nao faz parte do sistema)
/skill-observations/
# versoes de skill preparadas pela revisao semanal, com backup do estado
# anterior. Mesmo motivo: meta-trabalho, e o destino real delas e ~/.claude/
/skill-updates/

# symlinks locais para .agents/skills (o git no Windows os copiaria por inteiro)
/.claude/skills/
/.windsurf/

# ambiente Python da wiki (docs-requirements.txt) e o site que o MkDocs gera
/.venv-docs/
/site/

# binarios das ferramentas da wiki: Vale (linter de texto), bpmn-js (exportador
# de diagramas) e lychee (verificador de links). Nenhum e Python, entao nenhum
# cabe em docs-requirements.txt; e nenhum e do sistema, entao nenhum entra no
# package.json. As receitas de instalacao estao na secao "Documentacao" do
# CONTRIBUTING.md. O que E versionado e a configuracao (.vale.ini) e o
# vocabulario (.vale/styles/config/).
/.tools/

# estilo Microsoft do Vale, baixado pelo `vale sync` com a versao fixada no
# .vale.ini (D13). Mesma regra do executavel: artefato de terceiro nao entra no
# historico deste repositorio.
/.vale/styles/Microsoft/

# site construido so para o verificador de links (npm run docs:links). Fica no
# repositorio, e nao no temporario do sistema, para que o arquivo e a linha que
# o lychee aponta possam ser abertos quando um link quebrar.
/.site-links/
